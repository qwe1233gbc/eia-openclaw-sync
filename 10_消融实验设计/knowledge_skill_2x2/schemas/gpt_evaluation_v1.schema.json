{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt_evaluation_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_version",
    "blinded_output_id",
    "universal_scores",
    "functional_module",
    "functional_scores",
    "total_score",
    "basis_hallucination",
    "basis_hallucination_type",
    "abstention_appropriate",
    "fatal_error",
    "fatal_error_reason",
    "score_rationale",
    "evaluator_confidence",
    "requires_human_review"
  ],
  "properties": {
    "evaluation_version": {"const": "gpt_evaluation_v1"},
    "blinded_output_id": {"type": "string", "minLength": 1},
    "universal_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judgement_correctness",
        "report_evidence_quality",
        "key_issue_completeness",
        "logical_consistency_and_uncertainty"
      ],
      "properties": {
        "judgement_correctness": {"type": "integer", "minimum": 0, "maximum": 20},
        "report_evidence_quality": {"type": "integer", "minimum": 0, "maximum": 15},
        "key_issue_completeness": {"type": "integer", "minimum": 0, "maximum": 15},
        "logical_consistency_and_uncertainty": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "functional_module": {
      "enum": ["report_grounding", "basis_grounding", "numerical_accuracy", "procedural_reasoning", "evidence_integration"]
    },
    "functional_scores": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 3,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 20}
    },
    "total_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "basis_hallucination": {"type": "boolean"},
    "basis_hallucination_type": {
      "enum": ["none", "fabricated", "inapplicable", "outdated", "unsupported"]
    },
    "abstention_appropriate": {"type": "boolean"},
    "fatal_error": {"type": "boolean"},
    "fatal_error_reason": {"type": "string"},
    "score_rationale": {"type": "string"},
    "evaluator_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requires_human_review": {"type": "boolean"}
  }
}
